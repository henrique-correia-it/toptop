Options -Indexes -ExecCGI

# Bloqueia execução de PHP, scripts e HTML/SVG nesta pasta de imagens.
# Previne que ficheiros enviados sejam executados como código ou XSS.
<FilesMatch "(?i)\.(php\d?|phtml|phar|cgi|pl|py|sh|shtml|html?|svg)$">
    Require all denied
</FilesMatch>

# Força o Content-Type correto para imagens (evita MIME sniffing)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
